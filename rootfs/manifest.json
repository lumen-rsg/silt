{
  "format": "nevfs-v1",
  "size_mib": 8,
  "applications": [
    "check-cleanup",
    "check-faults",
    "check-pager-smp",
    "check-pipes",
    "check-signals",
    "check-terminal",
    "dash",
    "echo",
    "false",
    "id",
    "meminfo",
    "ps",
    "sysinfo",
    "true",
    "uname",
    "whoami"
  ],
  "required_paths": [
    "boot/dash-d2.sh",
    "boot/etc/hello.txt",
    "etc/group",
    "etc/motd",
    "etc/os-release",
    "etc/passwd",
    "etc/shadow"
  ]
}

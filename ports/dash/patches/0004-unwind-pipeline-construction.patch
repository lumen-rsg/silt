+void
+abortjob(struct job *jp)
+{
+	int restore;
+	int i;
+	int status;
+
+	silt_pipeline_abort();
+	if (!jp || !jp->used)
+		return;
+	// Linux stages can run before construction finishes. Terminate and
+	// reap them before restoring the terminal, so no late child handoff
+	// can steal it back. Silt's suspended stages were already reaped above.
+	for (i = 0; i < jp->nprocs; i++)
+		(void)kill(jp->ps[i].pid, SIGKILL);
+	for (i = 0; i < jp->nprocs; i++) {
+		while (waitpid(jp->ps[i].pid, &status, 0) < 0 && errno == EINTR)
+			;
+	}
+	restore = 0;
+#if JOBS
+	restore = jp->jobctl && !shlvl;
+#endif
+	freejob(jp);
+#if JOBS
+	if (restore)
+		xxtcsetpgrp(rootpid);
+#else
+	(void)restore;
+#endif
+}

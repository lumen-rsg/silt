+// Saving a redirection target must leave that target open on failure.
+// The newly opened source is locally owned until the target has been saved.
+static int
+save_redirect_target(int fd, int source, int owned)
+{
+	struct jmploc guard;
+	struct jmploc *outer = handler;
+	int saved;
+
+	if (setjmp(guard.loc)) {
+		handler = outer;
+		if (owned && source >= 0)
+			close(source);
+		exraise(exception);
+	}
+	handler = &guard;
+	saved = savefd(fd, -1);
+	handler = outer;
+	if (saved >= 0)
+		close(fd);
+	return saved;
+}
